"""Junos router secrets.

Type 9: a reversible Vigenere-like cipher used for `$9$` secrets in
Junos configurations.  Despite sharing the "$9$" magic with Cisco
Type 9, this is a completely different algorithm: a custom family-
based alphabet with positional encoding, fully reversible.

Inspired by https://metacpan.org/pod/Crypt::Juniper
"""
import testing
import random

_MAGIC = "$9$"

_FAMILY = ["QzF3n6/9CAtpu0O", "B1IREhcSyrleKvMW8LXx", "7N-dVbwsY2g4oaJZGUDj", "iHkq.mPf5T"]

_ENCODING = [[1, 4, 32], [1, 16, 32], [1, 8, 32], [1, 64], [1, 32], [1, 4, 16, 128], [1, 32, 64]]


def _get_extra() -> dict[str, int]:
    extra: dict[str, int] = {}
    idx: int = 0
    for fam in _FAMILY:
        for char in fam:
            extra[char] = 3 - idx
        idx += 1
    return extra


def _get_num_alpha() -> list[str]:
    num_alpha: list[str] = []
    for fam in _FAMILY:
        for char in fam:
            num_alpha.append(char)
    return num_alpha


def _get_alpha_num() -> dict[str, int]:
    num_alpha = _get_num_alpha()
    alpha_num: dict[str, int] = {}
    idx: int = 0
    for char in num_alpha:
        alpha_num[char] = idx
        idx += 1
    return alpha_num


def _nibble(cref: str, length: int) -> (str, str):
    nib: str = cref[:length]
    rest: str = cref[length:]
    if len(nib) != length:
        raise ValueError("Ran out of characters: hit '{nib}', expecting {length} chars")
    return (nib, rest)


def _gap(c1: str, c2: str) -> int:
    alpha_num = _get_alpha_num()
    num_alpha = _get_num_alpha()
    v1: int = alpha_num[c2]
    v2: int = alpha_num[c1]
    mod_val: int = len(num_alpha)
    diff: int = v1 - v2
    mod_result: int = diff % mod_val
    if mod_result < 0:
        mod_result += mod_val
    result: int = mod_result - 1
    return result


def _gap_decode(gaps: list[int], dec: list[int]) -> str:
    num: int = 0
    if len(gaps) != len(dec):
        raise ValueError("Nibble and decode size not the same")
    for idx in range(len(gaps)):
        num += gaps[idx] * dec[idx]
    return chr(num % 256)


def _reverse(my_list: list[int]) -> list[int]:
    new_list: list[int] = []
    idx: int = len(my_list) - 1
    while idx >= 0:
        new_list.append(my_list[idx])
        idx -= 1
    return new_list


def _gap_encode(pc: str, prev: str, encode: list[int]) -> str:
    alpha_num = _get_alpha_num()
    num_alpha = _get_num_alpha()
    _ord: int = ord(pc)

    crypt: str = ""
    gaps: list[int] = []
    reversed_encode: list[int] = _reverse(encode)

    for mod in reversed_encode:
        gaps.insert(0, _ord // mod)
        _ord = _ord % mod

    for gap in gaps:
        gap_val: int = gap + alpha_num[prev] + 1
        prev = num_alpha[gap_val % len(num_alpha)]
        crypt += prev

    return crypt


def _randc(cnt: int) -> str:
    num_alpha = _get_num_alpha()
    ret: str = ""
    for _ in range(cnt):
        ret += num_alpha[random.randint(0, len(num_alpha))]
    return ret


def junos_encrypt(plaintext: str, salt: ?str = None) -> str:
    extra = _get_extra()
    actual_salt = salt if salt is not None else _randc(1)

    # Fixed pad char (instead of random) so output is deterministic. The pad
    # is discarded on decrypt (junos_decrypt nibbles it off without feeding it
    # into the cipher chain), so its value is cosmetic — "T" is verified to
    # decode correctly on Juniper cRPD.
    rand: str = "T" * extra[actual_salt]

    pos: int = 0
    prev: str = actual_salt
    crypt: str = _MAGIC + actual_salt + rand

    for x in plaintext:
        encode: list[int] = _ENCODING[pos % len(_ENCODING)]
        crypt += _gap_encode(x, prev, encode)
        prev = crypt[len(crypt) - 1]
        pos += 1

    return crypt


def junos_decrypt(crypt: str) -> str:
    extra = _get_extra()
    chars: str = crypt[3:]  # Skip "$9$"
    nibble_result = _nibble(chars, 1)
    first_char: str = nibble_result.0
    chars = nibble_result.1
    nibble_result2 = _nibble(chars, extra[first_char])
    chars = nibble_result2.1
    prev: str = first_char
    decrypt: str = ""

    while len(chars) > 0:
        decode: list[int] = _ENCODING[len(decrypt) % len(_ENCODING)]
        nibble_result3 = _nibble(chars, len(decode))
        nibble: str = nibble_result3.0
        chars = nibble_result3.1
        gaps: list[int] = []
        for i in nibble:
            g: int = _gap(prev, i)
            prev = i
            gaps.append(g)
        decrypt += _gap_decode(gaps, decode)

    return decrypt


def _test_nibble():
    result = _nibble("hello", 2)
    testing.assertEqual(result.0, "he")
    testing.assertEqual(result.1, "llo")

    # Test exact length
    result2 = _nibble("ab", 2)
    testing.assertEqual(result2.0, "ab")
    testing.assertEqual(result2.1, "")


def _test_gap():
    gap_val = _gap("Q", "z")
    testing.assertEqual(gap_val, 0)


def _test_endecode():
    test_pairs: list[(str, str)] = [
        ("asdf", "$9$TzF/tu1cSeQF"),
        ("12345678900987654321", "$9$Tz/Cp0BESru07-bs4o/CAtIEM8Xx-VyrZUDHmPhSyeLxbs2JUjwsP5Qz6/"),
    ]

    for pair in test_pairs:
        plain: str = pair.0
        expected: str = pair.1
        # Test with specific salt to get consistent results
        salt: str = expected[3:4]  # Get the salt from expected string
        encoded: str = junos_encrypt(plain, salt)
        testing.assertEqual(encoded, expected)
        decoded: str = junos_decrypt(encoded)
        testing.assertEqual(decoded, plain)
